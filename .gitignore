# Derived, never committed (ADR: append-only data, rebuilt views)
.radar-cache/      # seen-key cache, LLM failure dumps — rebuildable from data/runs
.radar-dryrun/     # `radar daily --dry-run` output
_site/             # `radar site build` output; Pages builds it from data/
